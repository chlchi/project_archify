          "client_a",
          "net_a",
          "server",
          "net_b",
          "client_b"
        ],
        "note": "阈值过滤触发 PLAYER_UPDATE，服务端中继并由远端平滑插值。"
      },
      {
        "id": "combat-phase",
        "label": "权威伤害判定与广播",
        "focus": [
          "client_a",
          "net_a",
          "server",
          "anti_cheat",
          "net_b",
          "client_b"
        ],
        "note": "客户端上报击中，服务端校验防刷并原子广播受击与血量。"
      }
    ]
