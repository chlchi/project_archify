    {
      "dot": "emerald",
      "title": "网络通信契约",
      "items": [
        "基于 .NET 8 原生 TcpListener，采用 UTF-8 管道定界符协议",
        "客户端 20Hz 阈值 (0.1m/5°) 差异同步削减网络开销",
        "独立接收线程 + 主线程 Queue 解耦网络 IO 与渲染"
      ]
    },
    {
      "dot": "rose",
      "title": "服务端权威与防作弊",
      "items": [
        "全服血量与存活状态 (ClientInfo) 完全由服务端裁决",
        "基于攻击者-目标-位置复合键的 1 秒去重防连发外挂",
        "死亡与伤害全服原子广播 (PLAYER_DAMAGE_RECEIVED)"
      ]
    }
