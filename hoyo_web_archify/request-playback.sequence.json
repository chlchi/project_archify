  "cards": [
    {
      "dot": "cyan",
      "title": "帧差检测时序",
      "items": [
        "HeadlessRuntime 在主轮询 tick 中以 15 Hz 频率进行轻量帧捕获",
        "指纹门控耗时仅约 1ms，在文字处于打字机渐变态时直接返回 CHANGING",
        "仅在检测到 STABLE_NEW 判定后才唤起耗时更重的 OCR 深度推理"
      ]
    },
    {
      "dot": "emerald",
      "title": "路由与权重热切",
      "items": [
        "SpeakerRouter 极速返回规范化说话人与其预设权重文件路径",
        "VoiceSwitchingGptSovitsTts 比对前一次模型名称，同角色免重载权重",
        "POST /tts 仅需 ~0.5s 至 1s 即可完成短句至标准短句的端到端解码"
      ]
    },
    {
      "dot": "violet",
      "title": "异步播报与解耦",
      "items": [
        "Winsound 采用 SND_ASYNC 标志位播放，绝不阻塞下一次 tick 轮询",
        "事件中心支持发布 DIALOGUE_STARTED / COMPLETED / FAILED 等多种事件",
        "Web 控制台通过 WebSocket 实时订阅，保证前端 UI 状态始终同频"
      ]
    }
  ]
